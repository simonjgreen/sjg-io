---
import ThemeToggle from './ThemeToggle.astro'
import BurgerMenu from './BurgerMenu.astro'

const currentPath = Astro.url.pathname
const isHomePage = currentPath === '/'
---

<header class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700">
  <nav class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8" aria-label="Top">
    {
      isHomePage ? (
        <div class="flex w-full items-center justify-center py-6">
          <div class="sm:hidden">
            <BurgerMenu>
              <a
                href="/about"
                class="flex min-h-11 items-center rounded-md px-3 text-base font-medium text-gray-700 transition-colors hover:bg-gray-50 hover:text-neon-blue dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-neon-blue"
              >
                About
              </a>
              <a
                href="/work"
                class="flex min-h-11 items-center rounded-md px-3 text-base font-medium text-gray-700 transition-colors hover:bg-gray-50 hover:text-neon-blue dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-neon-blue"
              >
                Work
              </a>
              <a
                href="/writing"
                class="flex min-h-11 items-center rounded-md px-3 text-base font-medium text-gray-700 transition-colors hover:bg-gray-50 hover:text-neon-blue dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-neon-blue"
              >
                Writing
              </a>
              <a
                href="/now"
                class="flex min-h-11 items-center rounded-md px-3 text-base font-medium text-gray-700 transition-colors hover:bg-gray-50 hover:text-neon-blue dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-neon-blue"
              >
                Now
              </a>
              <a
                href="/contact"
                class="flex min-h-11 items-center rounded-md px-3 text-base font-medium text-gray-700 transition-colors hover:bg-gray-50 hover:text-neon-blue dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-neon-blue"
              >
                Contact
              </a>
              <ThemeToggle slot="theme-toggle" />
            </BurgerMenu>
          </div>
          <div class="hidden sm:flex items-center space-x-8">
            <a
              href="/about"
              class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue text-gray-500 dark:text-gray-400"
            >
              About
            </a>
            <a
              href="/work"
              class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue text-gray-500 dark:text-gray-400"
            >
              Work
            </a>
            <a
              href="/writing"
              class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue text-gray-500 dark:text-gray-400"
            >
              Writing
            </a>
            <a
              href="/now"
              class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue text-gray-500 dark:text-gray-400"
            >
              Now
            </a>
            <a
              href="/contact"
              class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue text-gray-500 dark:text-gray-400"
            >
              Contact
            </a>
            <ThemeToggle />
          </div>
        </div>
      ) : (
        <div class="flex w-full items-center justify-between py-6">
          <div class="flex items-center">
            <a href="/" class="text-xl font-bold text-neon-blue dark:text-neon-blue">
              Simon Green
            </a>
          </div>
          <div class="md:hidden">
            <BurgerMenu>
              <a
                href="/about"
                class={`flex min-h-11 items-center px-3 text-base font-medium rounded-md transition-colors ${
                  currentPath === '/about'
                    ? 'text-neon-blue dark:text-neon-blue bg-gray-100 dark:bg-gray-800'
                    : 'text-gray-700 dark:text-gray-300 hover:text-neon-blue dark:hover:text-neon-blue hover:bg-gray-50 dark:hover:bg-gray-800'
                }`}
              >
                About
              </a>
              <a
                href="/work"
                class={`flex min-h-11 items-center px-3 text-base font-medium rounded-md transition-colors ${
                  currentPath.startsWith('/work')
                    ? 'text-neon-blue dark:text-neon-blue bg-gray-100 dark:bg-gray-800'
                    : 'text-gray-700 dark:text-gray-300 hover:text-neon-blue dark:hover:text-neon-blue hover:bg-gray-50 dark:hover:bg-gray-800'
                }`}
              >
                Work
              </a>
              <a
                href="/writing"
                class={`flex min-h-11 items-center px-3 text-base font-medium rounded-md transition-colors ${
                  currentPath.startsWith('/writing')
                    ? 'text-neon-blue dark:text-neon-blue bg-gray-100 dark:bg-gray-800'
                    : 'text-gray-700 dark:text-gray-300 hover:text-neon-blue dark:hover:text-neon-blue hover:bg-gray-50 dark:hover:bg-gray-800'
                }`}
              >
                Writing
              </a>
              <a
                href="/now"
                class={`flex min-h-11 items-center px-3 text-base font-medium rounded-md transition-colors ${
                  currentPath === '/now'
                    ? 'text-neon-blue dark:text-neon-blue bg-gray-100 dark:bg-gray-800'
                    : 'text-gray-700 dark:text-gray-300 hover:text-neon-blue dark:hover:text-neon-blue hover:bg-gray-50 dark:hover:bg-gray-800'
                }`}
              >
                Now
              </a>
              <a
                href="/contact"
                class={`flex min-h-11 items-center px-3 text-base font-medium rounded-md transition-colors ${
                  currentPath === '/contact'
                    ? 'text-neon-blue dark:text-neon-blue bg-gray-100 dark:bg-gray-800'
                    : 'text-gray-700 dark:text-gray-300 hover:text-neon-blue dark:hover:text-neon-blue hover:bg-gray-50 dark:hover:bg-gray-800'
                }`}
              >
                Contact
              </a>
              <ThemeToggle slot="theme-toggle" />
            </BurgerMenu>
          </div>
          <div class="hidden md:flex items-center space-x-8">
            <a
              href="/about"
              class={`inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue ${
                currentPath === '/about'
                  ? 'text-neon-blue dark:text-neon-blue'
                  : 'text-gray-500 dark:text-gray-400'
              }`}
            >
              About
            </a>
            <a
              href="/work"
              class={`inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue ${
                currentPath.startsWith('/work')
                  ? 'text-neon-blue dark:text-neon-blue'
                  : 'text-gray-500 dark:text-gray-400'
              }`}
            >
              Work
            </a>
            <a
              href="/writing"
              class={`inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue ${
                currentPath.startsWith('/writing')
                  ? 'text-neon-blue dark:text-neon-blue'
                  : 'text-gray-500 dark:text-gray-400'
              }`}
            >
              Writing
            </a>
            <a
              href="/now"
              class={`inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue ${
                currentPath === '/now'
                  ? 'text-neon-blue dark:text-neon-blue'
                  : 'text-gray-500 dark:text-gray-400'
              }`}
            >
              Now
            </a>
            <a
              href="/contact"
              class={`inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-medium transition-colors hover:text-neon-blue dark:hover:text-neon-blue ${
                currentPath === '/contact'
                  ? 'text-neon-blue dark:text-neon-blue'
                  : 'text-gray-500 dark:text-gray-400'
              }`}
            >
              Contact
            </a>
            <ThemeToggle />
          </div>
        </div>
      )
    }
  </nav>
</header>
